<!DOCTYPE html>
<html {{ site.language.attributes }}>
    <head>
        <meta charset="{{ site.charset }}">
        {% block head %}
            <title>{{ site.title }}</title>
        {% endblock %}

        {{ function('wp_head') }}
    </head>

    <body id="page-top">
        {% include 'pages/_partials/_nav.twig' %}
        <main>
            {% block content %}
            {% endblock %}
        </main>

        <footer>
            {% block footer %}
            <div >
              <p class="copyright">&copy; Copyright <strong>DevFolio</strong>. All Rights Reserved. Designed by <a href="https://bootstrapmade.com/" style="color:white">BootstrapMade</a> - v.<span id="versionFile"></span></p>
              
            </div>
                
            {% endblock %}
            
        </footer>
         <a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

{{ function('wp_footer') }}
    </body>
    
</html>