<!DOCTYPE html>
<html {{ site.language.attributes }}>
    <head>
        <meta charset="{{ site.charset }}">
        {% block head %}
            <title>{{ site.title }}</title>
        {% endblock %}

        {{ function('wp_head') }}
    </head>

    <body id="page-top">
        {% include 'pages/_partials/_nav.twig' %}
        <main>
            {% block content %}
            {% endblock %}
        </main>

        <footer>
            {% block footer %}
                <p>Version : <span id="fileContent"></span></p>
            {% endblock %}
            
        </footer>
         <a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

{{ function('wp_footer') }}
    </body>
    
</html>