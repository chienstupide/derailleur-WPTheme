<section id="agenda" class="blog-mf sect-pt4 route">


    <div class="container">
      <div class="row">
        <div class="col-sm-12">
          <div class="title-box text-center">
            <h3 class="title-a">
              Agenda
            </h3>
            <div class="line-mf"></div>
          </div>
        </div>
      </div>
      <div class="row">
{# {{dump(posts_agenda.meta('_montheme_agenda_type_key'))}} #}
