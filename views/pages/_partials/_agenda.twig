{% for post in posts_agenda %}
    {# {{dump(post)}} #}
    {# {{dump(post.thumbnail.src)}} #}
  
		    <div class="col-md-4" style="padding-top:10px;margin-bottom:3em;">
          <div class="card card-blog" style="border-width:3px;">
            <div class="card-img">
              <a href="#"><img src="{{post.thumbnail.src}}" alt="" class="img-fluid"></a>
            </div>
            <div class="card-body">
              <div class="card-category-box">
                <div class="card-category">
                  <h4 class="category">{{ post.meta('_derailleur_agenda_type_key')}}</h4>
                </div>
              </div>
              <h3 class="card-title">{{post.title}}</h3>
              <p class="card-description">
                {{post.content}}
              </p>
            </div>
            <div class="card-footer">
              <div class="post-author">

              {% if (post.meta('_derailleur_agenda_lieu_key') is defined
                 and post.meta('_derailleur_agenda_lieu_key') is not empty) %} 
                 <span class="author" title="{{ post.meta('_derailleur_agenda_lieu_key') }}">
                    {{ post.meta('_derailleur_agenda_lieu_key') }}
                    </span>
                    {% else %}
                    Lieu de RDV à confirmer
                 {% endif %}

                
              </div>
              <div class="post-date">
                
                <span class="ion-ios-clock-outline"></span>
                Prochain RDV : 
                {% if (post.meta('_derailleur_agenda_date_key') is defined
                 and post.meta('_derailleur_agenda_date_key') is not empty) %} 
                    {{ post.meta('_derailleur_agenda_date_key') }}
                    {% else %}
                    à déterminer
                 {% endif %}
                  
              </div>
            </div>
          </div>
        </div>

{% endfor %}
