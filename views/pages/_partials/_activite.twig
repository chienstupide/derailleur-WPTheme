<section id="activite" class="blog-mf sect-pt4 route">
    <div class="container">

        <div class="row">
            <div class="col-sm-12">
                <div class="title-box text-center">
                <h3 class="title-a">
                    Activités
                </h3>
                <p class="subtitle-a">
                    <!-- texte présentation activités -->
                </p>
                <div class="line-mf"></div>
                </div>
            </div>
        </div>


      <div class="row">

        {% for post in  posts_activite %}
            <div class="col-md-4">
                <div class="service-box">
                        <div class="service-ico">
                            <img src="{{post.thumbnail.src}}" class="img-fluid rounded b-shadow-a" alt="">
                        </div>
                        <div class="service-content">
                            <h2 class="s-title">{{ post.title }}</h2>
                            <p class="s-description text-center">
                            {{ post.content  }}
                            </p>
                        </div>
                </div>
            </div>

            
        {% endfor %}
       
     
      </div>
    </div>
</section>
